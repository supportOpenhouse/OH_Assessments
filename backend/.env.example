# Neon — use the POOLED connection string
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs our 7-day session tokens. ONE key for the whole service, not one per
# user. Must be at least 32 characters — the app refuses to start otherwise,
# because PyJWT will happily sign with an empty key and produce forgeable
# tokens rather than erroring.
#   openssl rand -hex 32
JWT_SECRET=

# Google OAuth client id — the same one the frontend uses. Verified as the
# `aud` claim on every ID token.
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com

ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oh-assessments-audio

# Comma-separated Vercel domains allowed to call this API directly.
ALLOWED_ORIGINS=http://localhost:5175,https://your-app.vercel.app

# Optional override if scribe_v2 turns out not to be the right model id.
# STT_MODEL=scribe_v1
