# ─────────────────────────────────────────────────────────────────────────
#  REQUIRED — the app will not start without these
# ─────────────────────────────────────────────────────────────────────────

# Neon. Use the POOLED connection string (the one with `-pooler` in the host).
DATABASE_URL=

# Google OAuth client id — the same one the frontend uses. Verified as the `aud`
# claim on every ID token. Add these to that client's "Authorised JavaScript origins"
# or the sign-in popup refuses to open:
#   http://localhost:5175              (assessment Vite app)
#   http://localhost:8002              (openhouse.in website, local)
#   https://openhouse.in               (openhouse.in production)
#   https://oh-assessments.vercel.app  (assessment frontend on Vercel)
GOOGLE_OAUTH_CLIENT_ID=


# ─────────────────────────────────────────────────────────────────────────
#  REQUIRED to score — an upload will fail at that step without them
# ─────────────────────────────────────────────────────────────────────────

ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=
# Private bucket for candidate resumes; same API token, scoped to both buckets.
R2_RESUME_BUCKET=


# ─────────────────────────────────────────────────────────────────────────
#  LOCAL: leave everything below blank
#
#  ./run.sh fills these in for you with values that are correct on localhost
#  and wrong in production. Render never calls run.sh — it runs uvicorn
#  directly and takes these from render.yaml, so the defaults there stay strict.
# ─────────────────────────────────────────────────────────────────────────

# Signs the 7-day session cookie. Blank locally: run.sh generates a stable one
# in backend/.dev-secret so a restart does not sign you out.
#   Production:  openssl rand -hex 32
JWT_SECRET=

# A Secure cookie is never sent over http, so `true` breaks sign-in on
# localhost. run.sh defaults it to false. MUST be true anywhere deployed.
COOKIE_SECURE=

# sales_insight_rubric.md is the live rubric, so this does nothing. It only
# matters if someone drops a stub back in (one carrying the words "PLACEHOLDER RUBRIC"), at which
# point scoring refuses and this is the override. Never set it on a deployed
# service — a score from placeholder criteria looks real and gets acted on.
ALLOW_PLACEHOLDER_RUBRIC=

# Domains allowed to call this API directly. The Vite proxy and the Next.js /
# Vercel rewrite are same-origin, so this is only a backstop. main.py always
# includes localhost:5175, localhost:8002, https://openhouse.in, and
# https://oh-assessments.vercel.app as defaults.
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:8002,https://openhouse.in,https://oh-assessments.vercel.app

# Override only if scribe_v2 ever stops being the right model id.
# STT_MODEL=scribe_v1
