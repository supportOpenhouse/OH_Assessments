# ─────────────────────────────────────────────────────────────────────────
#  REQUIRED
# ─────────────────────────────────────────────────────────────────────────

# Google OAuth client id (the public half — safe to ship in the bundle).
# Without it the landing page has no sign-in button.
#
# In Google Cloud Console → Credentials → your OAuth client, add
# http://localhost:5175 to "Authorised JavaScript origins".
VITE_GOOGLE_OAUTH_CLIENT_ID=


# ─────────────────────────────────────────────────────────────────────────
#  LOCAL: leave blank
# ─────────────────────────────────────────────────────────────────────────

# LEAVE BLANK. Vite proxies /api/* in dev and Vercel rewrites it in production,
# so the browser only ever sees one origin — which is what lets the session
# cookie work at all.
#
# Pointing this at another origin breaks sign-in in a way that looks like a
# server bug: login returns a user, then every call 401s "not signed in". The
# browser will not store a cross-site Set-Cookie, and SameSite=Lax would refuse
# to send it anyway. client.js logs a console error if you do it.
VITE_API_BASE=

# To develop against the DEPLOYED backend, proxy to it instead of calling it —
# the browser still sees one origin, so the session survives:
#   VITE_PROXY_TARGET=https://oh-assessments.onrender.com npm run dev
# Defaults to http://localhost:5060.
VITE_PROXY_TARGET=
