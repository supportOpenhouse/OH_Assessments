# ─────────────────────────────────────────────────────────────────────────
#  REQUIRED
# ─────────────────────────────────────────────────────────────────────────

# Google OAuth client id (the public half — safe to ship in the bundle).
# Without it the landing page has no sign-in button.
#
# In Google Cloud Console → Credentials → your OAuth client, add
# http://localhost:5175 to "Authorised JavaScript origins".
VITE_GOOGLE_OAUTH_CLIENT_ID=


# ─────────────────────────────────────────────────────────────────────────
#  LOCAL: leave blank
# ─────────────────────────────────────────────────────────────────────────

# Blank = same origin, which is what you want everywhere. Vite proxies /api/*
# to localhost:5060 in dev and Vercel rewrites it to Render in production, so
# the browser only ever sees one origin — which is also what lets the session
# cookie work.
VITE_API_BASE=
