# Google OAuth client id (public half). Leave blank while mocks are on.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Blank = same origin. Vercel rewrites /api/* to the Render backend, and Vite's
# dev proxy does the same locally, so this normally stays empty.
VITE_API_BASE=

# "true" (default) resolves every API call from src/api/mock.js so the whole UI
# is browsable with no backend running. Set "false" once the backend is up.
VITE_USE_MOCKS=true
